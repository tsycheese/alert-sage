POSTGRES_DB=alert_sage
POSTGRES_USER=alert_sage
POSTGRES_PASSWORD=alert_sage
POSTGRES_PORT=5432
REDIS_PORT=6379
API_PORT=8000
WEB_PORT=5173

# Used when running the backend directly on the host.
ALERT_SAGE_DATABASE_URL=postgresql+psycopg://alert_sage:alert_sage@localhost:5432/alert_sage
ALERT_SAGE_TEST_DATABASE_URL=postgresql+psycopg://alert_sage:alert_sage@localhost:5432/alert_sage
ALERT_SAGE_REDIS_URL=redis://localhost:6379/1
ALERT_SAGE_CELERY_BROKER_URL=redis://localhost:6379/0
ALERT_SAGE_CORS_ORIGINS=["http://localhost:5173"]
ALERT_SAGE_WORKFLOW_TOOL_TIMEOUT_SECONDS=10
ALERT_SAGE_CASE_SYNC_TIMEOUT_SECONDS=180
ALERT_SAGE_KNOWLEDGE_RETRIEVAL_TIMEOUT_SECONDS=15

# Knowledge provider: keep mock for offline development, use dify for Dify Cloud.
ALERT_SAGE_KNOWLEDGE_PROVIDER=mock
ALERT_SAGE_DIFY_BASE_URL=https://api.dify.ai/v1
ALERT_SAGE_DIFY_DATASET_ID=
ALERT_SAGE_DIFY_API_KEY=
ALERT_SAGE_DIFY_HTTP_TIMEOUT_SECONDS=15
ALERT_SAGE_DIFY_POLL_INTERVAL_SECONDS=2
ALERT_SAGE_DIFY_MAX_RETRIES=2
