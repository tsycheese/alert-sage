# PostgreSQL
POSTGRES_DB=alert_sage
POSTGRES_USER=alert_sage
POSTGRES_PASSWORD=alert_sage
POSTGRES_PORT=15432

# Redis / API / Web host ports
REDIS_PORT=16379
API_PORT=18000
WEB_PORT=15173

# Observability host ports
WORKER_METRICS_PORT=19101
PROMETHEUS_PORT=19090
GRAFANA_PORT=13000

# Backend running directly on Windows
ALERT_SAGE_RUNTIME_PROFILE=
ALERT_SAGE_COMPONENT_ROLE=api
ALERT_SAGE_DATABASE_URL=postgresql+psycopg://alert_sage:alert_sage@localhost:15432/alert_sage
ALERT_SAGE_TEST_DATABASE_URL=postgresql+psycopg://alert_sage:alert_sage@localhost:15432/alert_sage
ALERT_SAGE_REDIS_URL=redis://localhost:16379/1
ALERT_SAGE_CELERY_BROKER_URL=redis://localhost:16379/0
ALERT_SAGE_CORS_ORIGINS=["http://localhost:15173"]
ALERT_SAGE_METRICS_ENABLED=true
ALERT_SAGE_LOG_LEVEL=INFO
ALERT_SAGE_CELERY_LOG_SERVICE=alert-sage-worker

# Transactional outbox
ALERT_SAGE_OUTBOX_POLL_INTERVAL_SECONDS=5
ALERT_SAGE_OUTBOX_BATCH_SIZE=50
ALERT_SAGE_OUTBOX_RETRY_BASE_SECONDS=2
ALERT_SAGE_OUTBOX_RETRY_MAX_SECONDS=60

# Workflow / asynchronous case sync
ALERT_SAGE_WORKFLOW_TOOL_TIMEOUT_SECONDS=10
ALERT_SAGE_CASE_SYNC_TIMEOUT_SECONDS=180
ALERT_SAGE_RAG_EVALUATION_LOCK_TTL_SECONDS=1800
ALERT_SAGE_RAG_EVALUATION_QUERY_INTERVAL_SECONDS=6.5
ALERT_SAGE_BUILD_REVISION=
ALERT_SAGE_KNOWLEDGE_RETRIEVAL_TIMEOUT_SECONDS=15

# Runtime profile selects the boundary: real requires dify/deepseek; demo/test require mock.
ALERT_SAGE_KNOWLEDGE_PROVIDER=
ALERT_SAGE_DIFY_BASE_URL=https://api.dify.ai/v1
ALERT_SAGE_DIFY_DATASET_ID=
ALERT_SAGE_DIFY_EVALUATION_DATASET_ID=<新的评测 Dataset ID>
ALERT_SAGE_DIFY_API_KEY=
ALERT_SAGE_DIFY_HTTP_TIMEOUT_SECONDS=15
ALERT_SAGE_DIFY_POLL_INTERVAL_SECONDS=2
ALERT_SAGE_DIFY_MAX_RETRIES=2

# Diagnostic model provider must agree with ALERT_SAGE_RUNTIME_PROFILE.
ALERT_SAGE_DIAGNOSTIC_MODEL_PROVIDER=
ALERT_SAGE_DIAGNOSTIC_MODEL_BASE_URL=https://api.deepseek.com
ALERT_SAGE_DIAGNOSTIC_MODEL_API_KEY=
ALERT_SAGE_DIAGNOSTIC_MODEL_NAME=deepseek-v4-flash
ALERT_SAGE_DIAGNOSTIC_MODEL_TIMEOUT_SECONDS=60
ALERT_SAGE_DIAGNOSTIC_MODEL_MAX_RETRIES=2
ALERT_SAGE_DIAGNOSTIC_MODEL_MAX_TOKENS=3000
ALERT_SAGE_DIAGNOSTIC_MODEL_TEMPERATURE=0.1
ALERT_SAGE_DIAGNOSTIC_MODEL_THINKING_ENABLED=false

# Feishu is optional only in real. These are placeholders; never commit actual credentials.
ALERT_SAGE_FEISHU_ENABLED=false
ALERT_SAGE_FEISHU_APP_ID=
ALERT_SAGE_FEISHU_APP_SECRET=
ALERT_SAGE_FEISHU_VERIFICATION_TOKEN=
ALERT_SAGE_FEISHU_ENCRYPT_KEY=
ALERT_SAGE_FEISHU_EXPECTED_TENANT_KEY=
ALERT_SAGE_FEISHU_TARGET_CHAT_ID=
ALERT_SAGE_FEISHU_SOURCE_ALLOWLIST=["synthetic-monitor"]
ALERT_SAGE_FEISHU_APPROVERS={"ou_placeholder":"On-call approver"}
ALERT_SAGE_FEISHU_WEB_BASE_URL=https://alerts.example.com
ALERT_SAGE_FEISHU_HTTP_TIMEOUT_SECONDS=5
ALERT_SAGE_FEISHU_MAX_RETRIES=2
